<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-contracts" value="./packages" />
  </packageSources>
  <!-- The user-level NuGet.Config enables packageSourceMapping (* -> nuget.org), which would
       otherwise exclude local-contracts. Declare the mapping here so the contract package
       resolves from the local feed while everything else still comes from nuget.org. -->
  <packageSourceMapping>
    <packageSource key="local-contracts">
      <package pattern="LogPipe.Contracts" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
